MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1945999614}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: aae4b7842cad7b24eb720c41cb7a65b9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  loadingProgressBar: {fileID: 1520376962}
  tipText: {fileID: 1257909446}
  gameTips:
  - "\uC0AC\uB9DD \uC2DC \uC790\uB3D9\uC73C\uB85C \uB9C8\uC9C0\uB9C9\uC5D0 \uC800\uC7A5\uD55C
    \uC0C1\uD0DC\uB85C \uB418\uB3CC\uC544\uAC00\uB2C8 \uC8FC\uC758\uD574\uC8FC\uC138\uC694!"
  - "\uC0AC\uC9C4 \uC18D \uAC15\uC544\uC9C0\uB294 \uC2E4\uC81C \uD0A4\uC6B0\uB294
    \uB9DD\uCE58\uB77C\uB294 \uBC18\uB824\uACAC\uC785\uB2C8\uB2E4^^"
  - "\uB358\uC804 \uC870\uAC01\uC758 \uAC80\uC740 \uBD80\uBD84\uB07C\uB9AC \uB2FF\uAC8C
    \uBC30\uCE58\uD558\uBA74 \uC0AC\uB77C\uC838\uC11C \uC774\uB3D9\uC774 \uAC00\uB2A5\uD574\uC9D1\uB2C8\uB2E4"
  - "\uC2A4\uD0EF \uD3EC\uC778\uD2B8\uB97C \uBD84\uBC30\uD55C \uB4A4 \uC801\uC6A9\uD558\uB294
    \uAC70 \uC78A\uC9C0 \uB9C8\uC138\uC694!"
  - "\uC2A4\uD0AC \uD3EC\uC778\uD2B8\uB97C \uBD84\uBC30\uD55C \uB4A4 \uC801\uC6A9\uD558\uB294
    \uAC70 \uC78A\uC9C0 \uB9C8\uC138\uC694!"
  - "NPC\uB4E4\uC758 \uC598\uAE30\uB97C \uB4E4\uC5B4\uC8FC\uB2E4\uBCF4\uBA74 \uC88B\uC740
    \uC77C\uC774 \uC0DD\uAE38\uC9C0\uB3C4...?"
  - "\uBC29\uC5B4\uAD6C\uB4E4 \uC911 \uC138\uD2B8\uD6A8\uACFC\uB97C \uB0B4\uB294
    \uC870\uD569\uB3C4 \uC788\uB2F5\uB2C8\uB2E4."
  - "\uB358\uC804 \uC810\uC218\uB97C \uB192\uC774\uBA74 \uB358\uC804\uC744 \uB05D\uB0C8\uC744
    \uB54C \uB354 \uC88B\uC740 \uBCF4\uC0C1\uC774 \uC9C0\uAE09\uB429\uB2C8\uB2E4."
  - "\uC801\uC6A9 \uC804\uC5D0\uB294 \uC2A4\uD0EF\uC774\uB4E0 \uC2A4\uD0AC\uC774\uB4E0
    \uC790\uC720\uB86D\uAC8C \uC218\uC815 \uAC00\uB2A5\uD558\uB098 \\n\uC801\uC6A9
    \uD6C4\uC5D0\uB294 \uC218\uC815\uC774 \uBD88\uAC00\uD569\uB2C8\uB2E4."
  - "\uC790\uC6D0\uC870\uAC01\uC5D0\uC11C\uB294 \uB808\uBCA8\uC5D0 \uB9DE\uB294 \uC7A5\uBE44\uB97C
    \uD68D\uB4DD\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  minDisplayTime: 3
