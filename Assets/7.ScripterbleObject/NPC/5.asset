%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 670d9726321f0054c99e5763332ebb59, type: 3}
  m_Name: 5
  m_EditorClassIdentifier: 
  npcID: 5
  npcName: "\uBC15\uC694\uB9AC"
  npcPersonality: "\uBCF8\uC778\uC758 \uC694\uB9AC\uC5D0 \uC790\uBD80\uC2EC \uC788\uB294
    \uC694\uB9AC\uC0AC,\uD76C\uADC0\uD55C \uC2DD\uC7AC\uB8CC\uB97C \uBCF4\uBA74 \uC815\uC2E0\uC744
    \uBABB\uCC28\uB9B0\uB2E4"
  relationships:
  - targetNPCName: "\uC774\uC21C\uB355"
    relationshipType: "\uC559\uC219"
  - targetNPCName: "\uCD5C\uCCA0\uC218"
    relationshipType: "\uC220\uCE5C\uAD6C"
  - targetNPCName: "\uC7A5\uBCF4\uB78C"
    relationshipType: "\uC0BC\uCD0C\uACFC \uC870\uCE74 \uC0AC\uC774"
  playerAffection: -100
  dialogueGroups:
  - questState: 0
    questID: 0
    interactionDialogue:
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uB0B4 \uC2DD\uB2F9\uC5D0 \uC628 \uAC83\uC744 \uD658\uC601\uD558\uB124.
        \uC74C\uC2DD\uC740 \uC5C6\uC9C0\uB9CC. \uD558\uD558."
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uD544\uC694\uD55C \uAC8C \uC788\uB2E4\uBA74 \uB9D0\uD558\uAC8C. \uD558\uC9C0\uB9CC...
        \uB0B4\uAC00 \uC904 \uC218 \uC788\uB294 \uAC74 \uC5C6\uB124. \uD558\uD558."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uC654\uB098? \uBC30\uAC00 \uACE0\uD508\uAC00? \uC2DD\uC7AC\uB8CC\uB97C
        \uAC00\uC838\uC624\uAC8C. \uB098\uB294... '\uC548\uC804\uD55C' \uC694\uB9AC\uB9CC\uC744
        \uB9CC\uB4DC\uB124."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uB098\uB294... \uADF8\uC800 \uC774\uACF3\uC5D0\uC11C \uC694\uB9AC\uB97C
        \uD560 \uBFD0\uC774\uB124. \uB354 \uC774\uC0C1... \uC544\uBB34\uAC83\uB3C4
        \uBB3B\uC9C0 \uB9D0\uAC8C."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC790\uB124\uAC00 \uAC00\uC838\uC628 \uC7AC\uB8CC\uB85C... \uB9DB\uC788\uB294
        \uAC78 \uB9CC\uB4E4\uC5B4\uC8FC\uC9C0. \uBB3C\uB860... \uB9DB\uC740 \uBCF4\uC7A5
        \uBABB \uD558\uB124. \uD558\uD558."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC790\uB124\uAC00 \uC624\uB294 \uB0A0\uC740... \uC660\uC9C0 \uBAA8\uB974\uAC8C...
        \uC2DD\uB2F9\uC774 \uB354 \uBC1D\uC544 \uBCF4\uC774\uB124."
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uC654\uB294\uAC00, \uCE5C\uAD6C\uC5EC! \uC790\uB124 \uB355\uBD84\uC5D0
        \uC774 \uC2DD\uB2F9\uC5D0 \uB2E4\uC2DC \uD65C\uAE30\uAC00 \uB118\uCE58\uB124."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC790\uB124\uB294... \uC815\uB9D0 \uC6A9\uAC10\uD55C \uC0AC\uB78C\uC774\uB124.
        \uB098\uB3C4... \uC790\uB124\uCC98\uB7FC \uB418\uACE0 \uC2F6\uC5C8\uC9C0."
    generalDialogues:
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uB098\uB294... \uB2F9\uC2E0 \uAC19\uC740 \uC0AC\uB78C\uC744 \uB9CE\uC774
        \uBD24\uB124."
      - "\uCC98\uC74C\uC5D0\uB294 \uBC1D\uACE0 \uC720\uCF8C\uD558\uC9C0\uB9CC...
        \uACB0\uAD6D\uC5D0\uB294... \uBAA8\uB450 \uC0AC\uB77C\uC84C\uC9C0."
      - "\uB2F9\uC2E0\uB3C4... \uACB0\uAD6D \uADF8\uB807\uAC8C \uB420 \uAC70\uC57C."
      - "\uB098\uB294... \uB2F9\uC2E0\uC5D0\uAC8C \uAE30\uB300\uD558\uC9C0 \uC54A\uACA0\uB124."
      - "\uADF8\uAC8C... \uB098\uB97C \uC9C0\uD0A4\uB294 \uBC29\uBC95\uC774\uB2C8."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uB098\uB294... \uC608\uC804\uC5D0... \uB0B4 \uC694\uB9AC\uAC00 \uC0AC\uB78C\uB4E4\uC744
        \uBBF8\uCE58\uAC8C \uB9CC\uB4E4\uC5C8\uB2E4\uB294 \uAC83\uC744 \uC54C\uC558\uB124."
      - "\uADF8\uB798\uC11C... \uB098\uB294... \uB354 \uC774\uC0C1 \uC694\uB9AC\uB97C
        \uD558\uC9C0 \uC54A\uC544."
      - "\uB9CC\uB4E4\uACE0 \uC2F6\uC9C0\uB3C4 \uC54A\uB124."
      - "\uADF8\uC800... \uC774 \uC2DD\uB2F9\uC5D0\uC11C \uC870\uC6A9\uD788 \uC0B4\uACE0
        \uC2F6\uC744 \uBFD0\uC774\uB124. \uD558\uD558."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uB098\uB294... \uC608\uC804\uC5D0... **'\uB4A4\uD2C0\uB9B0 \uC232'**\uC5D0\uC11C
        \uBD88\uAE38\uD55C \uAE30\uC6B4\uC744 \uB290\uAF08\uB124."
      - "\uADF8 \uAE30\uC6B4\uC774... \uB098\uC758 \uC694\uB9AC\uB97C... \uD558\uD558...
        \uC544\uBB34\uAC83\uB3C4 \uC544\uB2C8\uB124."
      - "\uADF8\uC800... \uCD94\uC5B5\uC774 \uB5A0\uC62C\uB790\uC744 \uBFD0\uC774\uB124."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC790\uB124... \uD639\uC2DC \uD751\uB9C8\uC11D\uC774\uB77C\uB294 \uAC83\uC744
        \uBCF8 \uC801 \uC788\uB098?"
      - "\uADF8\uAC74... \uB0B4\uAC00 \uB9CC\uB4E0 \uC694\uB9AC\uC640 \uBE44\uC2B7\uD558\uB124."
      - "\uC0AC\uB78C\uC744 \uD574\uCE58\uB294... \uBB34\uC11C\uC6B4 \uD798\uC774
        \uB2F4\uACA8\uC788\uC9C0."
      - "\uB098\uB294... \uADF8\uB0A0 \uC774\uD6C4... \uB354 \uC774\uC0C1 **'\uB9DB'**\uC744
        \uD3EC\uAE30\uD588\uB124."
      - " \uC774\uC81C... **'\uC548\uC804'**\uB9CC\uC774 \uC911\uC694\uD574."
