  m_Script: {fileID: 11500000, guid: 670d9726321f0054c99e5763332ebb59, type: 3}
  m_Name: 2
  m_EditorClassIdentifier: 
  npcID: 2
  npcName: "\uC774\uC21C\uB355"
  npcPersonality: "\uC7A5\uD130\uB124 \uAC00\uC871\uC758 \uC5B4\uBA38\uB2C8,\uB9C8\uC744
    \uC18C\uBB38\uC5D0 \uBE60\uC0AD\uD558\uBA70 \uBC15\uC694\uB9AC\uC640 \uC808\uCE5C"
  relationships:
  - targetNPCName: "\uC7A5\uBCF4\uB78C"
    relationshipType: "\uB538"
  - targetNPCName: "\uC7A5\uD544\uC218"
    relationshipType: "\uB0A8\uD3B8"
  - targetNPCName: "\uC7A5\uB3D9\uBBFC"
    relationshipType: "\uC544\uB4E4"
  playerAffection: -100
  dialogueGroups:
  - questState: 0
    questID: 0
    interactionDialogue:
    - minAffection: -100
      maxAffection: -90
      dialogueTexts:
      - "\uB204\uAD6C\uC138\uC694?"
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uC544\uC774\uACE0, \uB9D9\uC18C\uC0AC! \uB0AF\uC120 \uC190\uB2D8\uC774
        \uC654\uB124. \uADF8\uCABD\uC740... \uB0B4\uAC00 \uC544\uB294 \uC0AC\uB78C\uC774
        \uC544\uB2C8\uAD6C\uBA3C."
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uC704\uD5D8\uD55C \uACF3\uC5D0\uB294 \uAC00\uC9C0 \uB9D0\uC544\uC694. \uBB34\uC11C\uC6B4
        \uC18C\uBB38\uC774 \uC790\uC790\uD558\uB2C8."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uC544\uC774\uACE0, \uB0AF\uC120 \uC190\uB2D8! \uB358\uC804\uC740 \uC815\uB9D0
        \uBB34\uC11C\uC6B4 \uACF3\uC774\uC5D0\uC694. \uC870\uC2EC\uD574\uC57C \uD574\uC694!"
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uC6B0\uB9AC \uC544\uB4E4\uB0B4\uBBF8\uAC00 \uC790\uAFB8 \uADF8\uCABD\uC73C\uB85C
        \uAC00\uB824 \uD574\uC11C \uAC71\uC815\uC774\uC57C. \uD639\uC2DC \uADF8\uCABD\uC744
        \uBCF4\uBA74... \uB9D0\uB824\uC918\uC694."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC544\uC774\uACE0, \uC190\uB2D8! \uC6B0\uB9AC \uC544\uB4E4\uB0B4\uBBF8\uAC00
        \uC815\uB9D0 \uC88B\uC544\uD588\uC5B4. \uACE0\uB9C8\uC6CC\uC694... \uC815\uB9D0
        \uACE0\uB9C8\uC6CC\uC694."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC774\uACF3\uC740... \uC815\uB9D0 \uC704\uD5D8\uD55C \uACF3\uC774\uC5D0\uC694.
        \uD558\uC9C0\uB9CC... \uB2F9\uC2E0 \uAC19\uC740 \uC0AC\uB78C\uC774 \uC788\uC5B4\uC11C
        \uB2E4\uD589\uC774\uB124."
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uC544\uC774\uACE0, \uC190\uB2D8! \uB2F9\uC2E0\uC740... \uC815\uB9D0 \uC6B0\uB9AC
        \uAC00\uC871\uC758 \uC740\uC778\uC774\uB124. \uC815\uB9D0 \uACE0\uB9C8\uC6CC\uC694..."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uB098\uB294... \uB354 \uC774\uC0C1 \uBB34\uC11C\uC6CC\uD558\uC9C0 \uC54A\uC544\uC694.
        \uB2F9\uC2E0\uC774 \uC788\uC73C\uB2C8... \uC548\uC2EC\uC774 \uB418\uB124."
    generalDialogues:
    - minAffection: -100
      maxAffection: -90
      dialogueTexts:
      - "\uB0A0\uC528\uAC00 \uC88B\uB124\uC694 \uC774\uB7F0 \uB0A0\uC740 \uC232\uC5D0\uC11C
        \uC0B0\uCC45\uC774\uB77C\uB3C4 \uD574\uC57C\uD558\uB294\uB370..."
      - "\uC5B4\uCA4C\uB2E4 \uC6B0\uB9AC\uB9C8\uC744\uC774 \uC774\uB807\uAC8C \uB41C\uAC74\uC9C0..."
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uB098\uB294... \uB2F9\uC2E0 \uAC19\uC740 \uC0AC\uB78C\uC744 \uB9CE\uC774
        \uBD24\uC5B4."
      - "\uCC98\uC74C\uC5D0\uB294 \uBC1D\uACE0 \uC720\uCF8C\uD558\uC9C0\uB9CC...
        \uACB0\uAD6D\uC5D0\uB294... \uBAA8\uB450 \uC0AC\uB77C\uC84C\uC9C0."
      - "\uB2F9\uC2E0\uB3C4... \uACB0\uAD6D \uADF8\uB807\uAC8C \uB420 \uAC70\uC57C."
      - "\uB098\uB294... \uB2F9\uC2E0\uC5D0\uAC8C \uAE30\uB300\uD558\uC9C0 \uC54A\uACA0\uB124."
      - "\uADF8\uAC8C... \uB098\uB97C \uC9C0\uD0A4\uB294 \uBC29\uBC95\uC774\uB2C8."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uB098\uB294... \uD56D\uC0C1 \uAC71\uC815\uC774 \uB9CE\uB124."
      - "\uC6B0\uB9AC \uB0A8\uD3B8\uC774 \uB2E4\uC2DC \uB358\uC804\uC73C\uB85C \uAC08\uAE4C
        \uBD10, \uC6B0\uB9AC \uC544\uB4E4\uB0B4\uBBF8\uAC00 \uB2E4\uCE60\uAE4C \uBD10..."
      - "\uB9E4\uC77C \uBC24\uB9C8\uB2E4 \uC7A0\uC744 \uC124\uCE5C\uB2E4\uB124."
      - "\uB2F9\uC2E0\uB3C4... \uC704\uD5D8\uD55C \uBAA8\uD5D8\uC740 \uD558\uC9C0
        \uB9D0\uC544\uC694."
      - "\uB2F9\uC2E0\uC774 \uB2E4\uCE58\uBA74... \uB098\uB3C4 \uC544\uD504\uB2C8."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uB098\uB294... \uC6B0\uB9AC \uB0A8\uD3B8\uC774... \uC608\uC804\uC5D0 \uD751\uB9C8\uC11D\uC744
        \uCE90\uB0C8\uB2E4\uB294 \uAC83\uC744 \uC54C\uC558\uB124."
      - "\uADF8\uAC8C... \uC6B0\uB9AC \uC544\uB4E4\uB0B4\uBBF8\uB97C \uB2E4\uCE58\uAC8C
        \uD588\uB2E4\uB294 \uAC83\uB3C4."
      - "\uB098\uB294... \uADF8\uB0A0 \uC774\uD6C4... \uB354 \uC774\uC0C1 \uC544\uBB34\uAC83\uB3C4
        \uBBFF\uC9C0 \uC54A\uB124."
      - "\uADF8\uC800... \uC774 \uC7A5\uD130\uC5D0\uC11C \uC870\uC6A9\uD788 \uC0B4\uACE0
        \uC2F6\uC744 \uBFD0\uC774\uB124"
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uB098\uB294... \uC6B0\uB9AC \uB0A8\uD3B8\uC774... \uD751\uB9C8\uC11D\uC744
        \uCE90\uB0B4\uAE30 \uC804, \uB9C8\uC744\uC5D0... \uBB34\uC11C\uC6B4 \uC18C\uBB38\uC774
        \uB3CC\uC558\uC5B4. "
      - "**'\uB9C8\uB140'**\uAC00 \uB098\uD0C0\uB0AC\uB2E4\uACE0... \uADF8 \uC18C\uBB38\uC774...
        \uC6B0\uB9AC \uB0A8\uD3B8\uC744... **'\uC601\uC6C5'**\uC73C\uB85C \uB9CC\uB4E4\uC5C8\uC9C0."
      - "\uD558\uC9C0\uB9CC... \uB098\uB294... \uADF8 \uC18C\uBB38\uC744 \uBBFF\uC9C0
        \uC54A\uC558\uB124."
      - "\uB098\uB294... \uADF8\uC800... \uD3C9\uD654\uB86D\uAC8C \uC0B4\uACE0 \uC2F6\uC5C8\uB124."
      - "\uB098\uB294... \uADF8\uB0A0\uC758... \uC8C4\uCC45\uAC10\uC5D0 \uC2DC\uB2EC\uB9AC\uACE0
        \uC788\uB124."
  - questState: 2
    questID: 1
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uC544\uC774\uACE0, \uB0AF\uC120 \uC190\uB2D8!"
      - "\uC18C\uBB38\uC5D0 \uB2E4\uB78C\uC950\uAC00 \uD589\uBCF5\uC758 \uB3C4\uD1A0\uB9AC\uB97C
        \uC228\uACA8\uB454\uB300\uC694! "
      - "\uB3C4\uD1A0\uB9AC 10\uAC1C\uB9CC \uAC00\uC838\uC640 \uC8FC\uBA74... \uC6B0\uB9AC
        \uB3D9\uBBFC\uC774\uAC00 \uC88B\uC544\uD560 \uAC70\uC57C!"
      - "\uBD88\uAE38\uD55C \uAE30\uC6B4\uC744 \uB9C9\uC544\uC900\uB2E4\uB294 \uC18C\uBB38\uB3C4
        \uC788\uC73C\uB2C8..."
  - questState: 3
    questID: 1
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uAD1C\uCC2E\uC544\uC694. \uADF8 \uB3C4\uD1A0\uB9AC\uB294... \uCC3E\uAE30
        \uD798\uB4E4 \uAC70\uC608\uC694."
      - "\uC18C\uBB38\uC774\uB77C\uB294 \uAC8C \uB2E4 \uADF8\uB807\uC9C0..."
      - "\uB108\uBB34 \uC704\uD5D8\uD55C \uC77C\uC740 \uD558\uC9C0 \uB9D0\uC544\uC694."
  - questState: 4
    questID: 1
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uC544\uC774\uACE0, \uACE0\uB9C8\uC6CC\uC694! \uC815\uB9D0 \uACE0\uB9C8\uC6CC\uC694!"
      - "\uC774\uAC78 \uC6B0\uB9AC \uB3D9\uBBFC\uC774\uC5D0\uAC8C \uC8FC\uBA74...
        \uB9C8\uC74C\uC774 \uC870\uAE08\uC740 \uD3B8\uD574\uC9C0\uACA0\uB124."
      - "\uB2F9\uC2E0 \uB355\uBD84\uC5D0 \uC548\uC2EC\uC774 \uB3FC\uC694."
  - questState: 5
    questID: 1
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uB2F9\uC2E0\uC774 \uAC00\uC838\uC628 \uB3C4\uD1A0\uB9AC \uB355\uBD84\uC5D0
        \uB3D9\uBBFC\uC774\uAC00 \uBC24\uC5D0 \uC798 \uC794\uB300\uC694."
      - "\uB2F9\uC2E0\uC740... \uC18C\uBB38\uC744 \uB108\uBB34 \uBBFF\uC9C0 \uB9D0\uC544\uC694."
  - questState: 2
