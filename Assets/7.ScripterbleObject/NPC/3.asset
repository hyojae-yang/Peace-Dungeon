  m_Script: {fileID: 11500000, guid: 670d9726321f0054c99e5763332ebb59, type: 3}
  m_Name: 3
  m_EditorClassIdentifier: 
  npcID: 3
  npcSprite: {fileID: 21300000, guid: ff37e0c98d428144ab3b28850670901c, type: 3}
  npcName: "\uC7A5\uBCF4\uB78C"
  npcPersonality: "\uC7A5\uD130\uB124 \uAC00\uC871\uC758 \uB538,\uD638\uAE30\uC2EC\uC774
    \uB9CE\uC544\uC11C \uB358\uC804\uC5D0 \uAD00\uC2EC\uC774 \uB9CE\uB2E4."
  relationships:
  - targetNPCName: "\uC774\uC21C\uB355"
    relationshipType: "\uC5B4\uBA38\uB2C8"
  - targetNPCName: "\uC7A5\uD544\uC218"
    relationshipType: "\uC544\uBC84\uC9C0"
  - targetNPCName: "\uC7A5\uB3D9\uBBFC"
    relationshipType: "\uB0A8\uB3D9\uC0DD"
  playerAffection: -100
  dialogueGroups:
  - questState: 0
    questID: 0
    interactionDialogue:
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uC624\uBE60... \uB098\uB791 \uB3D9\uBBFC\uC774\uD55C\uD14C \uBB34\uC2A8
        \uC9D3 \uD558\uB824\uB294 \uAC70 \uC544\uB2C8\uC9C0?"
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uC544\uBE60\uAC00 \uADF8\uB7AC\uC5B4... \uBAA8\uB974\uB294 \uC0AC\uB78C
        \uB530\uB77C\uAC00\uBA74 \uC548 \uB41C\uB2E4\uACE0..."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uC548\uB155... \uB358\uC804\uC740 \uBB34\uC12D\uC9C0\uB9CC... \uBAA8\uD5D8\uAC00\uB294
        \uBA4B\uC788\uB294 \uAC83 \uAC19\uC544."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uC6B0\uB9AC \uC544\uBE60\uAC00... \uC608\uC804\uC5D0\uB294 \uC5C4\uCCAD
        \uBA4B\uC788\uC5C8\uB300. \uC9C0\uAE08\uC740... \uADF8\uB807\uC9C0 \uC54A\uC9C0\uB9CC..."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC624\uBE60! \uC624\uBE60! \uB098\uB791 \uB180\uC544\uC904\uB798? \uC6B0\uB9AC
        \uB3D9\uBBFC\uC774\uAC00 \uC624\uBE60 \uC5C4\uCCAD \uC88B\uC544\uD574!"
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC624\uBE60\uB294... \uC6B0\uB9AC \uC544\uBE60\uB791 \uB2EE\uC558\uC5B4.
        \uADF8\uB798\uC11C \uC88B\uC544!"
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uC624\uBE60\uB294... \uB0B4 \uC601\uC6C5\uC774\uC57C! \uC6B0\uB9AC \uAC00\uC871\uC744
        \uAD6C\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC!"
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uC624\uBE60, \uC6B0\uB9AC \uC544\uBE60\uB791 \uC5C4\uB9C8\uAC00 \uB2E4\uC2DC
        \uC6C3\uC744 \uC218 \uC788\uB3C4\uB85D... \uB3C4\uC640\uC918!"
    generalDialogues:
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uC624\uBE60... \uB098\uB791 \uB3D9\uBBFC\uC774\uB294... \uD589\uBCF5\uD574."
      - "\uC6B0\uB9AC \uAC00\uC871\uC740... \uC2AC\uD504\uC9C0 \uC54A\uC544."
      - "\uADF8\uB7EC\uB2C8\uAE4C... \uC624\uBE60\uB294... \uC6B0\uB9AC\uD55C\uD14C
        \uAD00\uC2EC \uB044\uACE0... \uADF8\uB0E5 \uAC00"
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uC624\uBE60\uB294... \uC65C \uADF8\uB807\uAC8C \uC6A9\uAC10\uD574?"
      - "\uB358\uC804\uC740 \uBB34\uC12D\uC796\uC544. "
      - "\uB098\uB3C4... \uC6A9\uAC10\uD574\uC9C0\uACE0 \uC2F6\uC9C0\uB9CC... \uBB34\uC11C\uC6CC."
      - "\uC6B0\uB9AC \uC5C4\uB9C8\uB294... \uB9E4\uC77C \uBC24\uB9C8\uB2E4 \uC6B8\uC5B4."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC624\uBE60! \uC624\uBE60!"
      - "\uC6B0\uB9AC \uC544\uBE60\uAC00... \uC608\uC804\uC5D0 \uC5C4\uCCAD \uBA4B\uC788\uC5C8\uB300!"
      - "\uADFC\uB370... \uC9C0\uAE08\uC740... \uADF8\uB807\uC9C0 \uC54A\uC544."
      - "\uADF8\uB798\uC11C... \uB098\uB294... \uC544\uBE60\uAC00 \uB2E4\uC2DC \uC6C3\uC744
        \uC218 \uC788\uB3C4\uB85D... \uB178\uB825\uD560 \uAC70\uC57C!"
      - "\uC624\uBE60\uAC00... \uB3C4\uC640\uC904 \uC218 \uC788\uC5B4?"
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uC624\uBE60\uB294... \uB0B4 \uC601\uC6C5\uC774\uC57C!"
      - "\uC6B0\uB9AC \uAC00\uC871\uC744 \uAD6C\uD574\uC918\uC11C \uACE0\uB9C8\uC6CC! "
      - "\uC624\uBE60 \uB355\uBD84\uC5D0... \uC6B0\uB9AC \uC544\uBE60\uB791 \uC5C4\uB9C8\uAC00
        \uB2E4\uC2DC \uC6C3\uC744 \uC218 \uC788\uAC8C \uB418\uC5C8\uC5B4."
      - "\uC815\uB9D0 \uACE0\uB9C8\uC6CC!"
