%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 670d9726321f0054c99e5763332ebb59, type: 3}
  m_Name: 1
  m_EditorClassIdentifier: 
  npcID: 1
  npcSprite: {fileID: 21300000, guid: d659f7396cd57754eba78763cf986c51, type: 3}
  npcName: "\uC7A5\uD544\uC218"
  npcPersonality: "\uC7A5\uD130\uB124 \uAC00\uC871\uC758 \uAC00\uC7A5,\uC0C1\uC810
    \uC6B4\uC601,\uAE30\uBCF8\uC544\uC774\uD15C \uD310\uB9E4"
  relationships:
  - targetNPCName: "\uC7A5\uBCF4\uB78C"
    relationshipType: "\uB538"
  - targetNPCName: "\uC774\uC21C\uB355"
    relationshipType: "\uC544\uB0B4"
  - targetNPCName: "\uC7A5\uB3D9\uBBFC"
    relationshipType: "\uC544\uB4E4"
  playerAffection: -100
  dialogueGroups:
  - questState: 0
    questID: 0
    interactionDialogue:
    - minAffection: -100
      maxAffection: -90
      dialogueTexts:
      - "\uC790\uB124\uB294 \uB204\uAD6C\uC778\uAC00?"
    - minAffection: -90
      maxAffection: -50
      dialogueTexts:
      - "\uBB34\uC2A8 \uC77C\uC778\uAC00? \uC774 \uB0C4\uC0C8... \uB358\uC804\uC758
        \uB0C4\uC0C8\uAC00 \uB098\uB294\uAD6C\uBA3C."
    - minAffection: -90
      maxAffection: -50
      dialogueTexts:
      - "\uBCFC\uC77C\uC774 \uC5C6\uB2E4\uBA74 \uAD1C\uD788 \uB9D0 \uAC78\uC9C0 \uB9D0\uAC8C.
        \uB0B4\uAC8C\uB294... \uB354 \uC774\uC0C1 \uD574\uC904 \uB9D0\uC774 \uC5C6\uB124."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uC654\uB098? \uD544\uC694\uD55C \uAC8C \uC788\uB2E4\uBA74 \uB9D0\uD558\uAC8C.
        \uBD88\uD544\uC694\uD55C \uC774\uC57C\uAE30\uB294... \uC0AC\uC591\uD558\uB124."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uB358\uC804\uC740 \uC704\uD5D8\uD558\uB124. \uC790\uB124\uB3C4 \uC870\uC2EC\uD558\uAC8C.
        \uD558\uD558... \uB098 \uAC19\uC740 \uC2E4\uC218\uB294 \uD558\uC9C0 \uB9D0\uAC8C."
    - minAffection: 1
      maxAffection: 50
      dialogueTexts:
      - "\uC790\uB124 \uB355\uBD84\uC5D0 \uC544\uB4E4\uB0B4\uBBF8\uAC00 \uC6C3\uB294\uAD70.
        \uADF8 \uC6C3\uC74C... \uB0B4\uAC00 \uC783\uC5C8\uB358 \uAC83\uACFC \uAC19\uC544\uC11C
        \uB9C8\uC74C\uC774 \uC88B\uB124."
    - minAffection: 1
      maxAffection: 50
      dialogueTexts:
      - "\uC790\uB124... \uC660\uC9C0 \uBAA8\uB974\uAC8C... \uB0B4 \uC61B \uBAA8\uC2B5\uC744
        \uBCF4\uB294 \uAC83 \uAC19\uAD70. \uC870\uC2EC\uD558\uAC8C... \uC6A9\uAE30\uAC00...
        \uC8C4\uAC00 \uB420 \uC218\uB3C4 \uC788\uC73C\uB2C8."
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uC790\uB124\uAC00 \uC624\uB294 \uB0A0\uC740... \uC660\uC9C0 \uBAA8\uB974\uAC8C
        \uAE30\uBD84\uC774 \uC88B\uAD70. \uC774 \uC7A5\uD130\uC5D0... \uB2E4\uC2DC
        \uD587\uC0B4\uC774 \uBE44\uCD94\uB294 \uAC83 \uAC19\uB124."
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uC774 \uC7A5\uD130\uB294... \uC790\uB124\uC5D0\uAC8C \uD56D\uC0C1 \uC5F4\uB824\uC788\uB124.
        \uC5B8\uC81C\uB4E0 \uD3B8\uD558\uAC8C \uB4E4\uB974\uAC8C"
    generalDialogues:
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uB098\uB294 \uADF8\uC800 \uC774\uACF3\uC758 \uC0C1\uC778\uC77C\uC138. "
      - "\uC790\uB124\uC758 \uBAA8\uD5D8\uB2F4\uC774\uB098 \uACFC\uAC70\uC5D0 \uB300\uD574
        \uC54C\uACE0 \uC2F6\uC9C0 \uC54A\uB124. "
      - "\uB358\uC804\uC758 \uC774\uC57C\uAE30\uB294... \uB354 \uC774\uC0C1 \uB4E3\uACE0
        \uC2F6\uC9C0 \uC54A\uB124."
      - "\uB0B4\uAC00 \uBC84\uB9B0 \uAC83\uB4E4\uC744... \uC790\uB124\uAC00 \uB2E4\uC2DC
        \uCC3E\uB294 \uAC83 \uAC19\uC544\uC11C... \uB9C8\uC74C\uC774 \uBD88\uD3B8\uD558\uB124."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uC790\uB124\uAC00 \uAC00\uC838\uC628 \uBB3C\uAC74\uC740... \uAF64 \uC4F8\uBAA8\uAC00
        \uC788\uAD70."
      - "\uB358\uC804\uC5D0\uC11C \uBB34\uC5B8\uAC00\uB97C \uC5BB\uC5B4\uC624\uB294
        \uAC74..."
      - "\uC790\uB124 \uAC19\uC740 \uBAA8\uD5D8\uAC00\uC758 \uC219\uBA85\uC774\uACA0\uC9C0. "
      - "\uD558\uC9C0\uB9CC \uAE30\uC5B5\uD558\uAC8C."
      - "\uBAA8\uB4E0 \uBAA8\uD5D8\uC758 \uB05D\uC740... \uACB0\uAD6D \uD6C4\uD68C\uBFD0\uC774\uB77C\uB294
        \uAC83\uC744."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC6B0\uB9AC \uC7A5\uD130\uC5D0... \uD751\uB9C8\uC11D\uC774\uB77C\uB294
        \uBD88\uAE38\uD55C \uB3CC\uBA69\uC774\uAC00 \uC788\uC5C8\uB2E4\uB124."
      - "\uB098\uB294... \uADF8 \uB3CC\uBA69\uC774\uB97C... \uB0B4 \uC544\uB4E4\uB0B4\uBBF8\uB97C
        \uC704\uD574 \uC37C\uC9C0."
      - "\uD5C8\uB098... \uADF8 \uB3CC\uBA69\uC774\uC758 \uC800\uC8FC\uAC00... \uB0B4
        \uC544\uB4E4\uC758 \uB2E4\uB9AC\uB97C \uB9DD\uAC00\uB728\uB838\uB124."
      - "\uB098\uB294... \uADF8\uB0A0 \uC774\uD6C4... \uC774 \uC7A5\uD130\uC5D0 \uD2C0\uC5B4\uBC15\uD600
        \uC0B4\uACE0 \uC788\uB2E4\uB124."
      - "\uB0B4\uAC00... \uAC00\uC871\uC744 \uBC84\uB9B0 \uC8C4\uB97C... \uC6A9\uC11C\uBC1B\uC744
        \uC218 \uC788\uC744\uAE4C?"
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uC790\uB124... \uB0B4\uAC00... \uACFC\uAC70\uC5D0 \uC8C4\uC5C6\uB294 \uC5EC\uC778\uC744
        \uB9C8\uB140\uB85C \uBAB0\uC544 \uC8FD\uAC8C \uD588\uB124."
      - "\uB098\uB294... \uADF8\uB0A0 \uC774\uD6C4... \uADF8 \uC8C4\uCC45\uAC10\uC5D0
        \uC2DC\uB2EC\uB9AC\uACE0 \uC788\uB2E4\uB124."
      - "\uB098\uB294... \uC9C4\uC815\uD55C \uC601\uC6C5\uC774 \uC544\uB2C8\uC5C8\uB124."
      - "\uB098\uB294... \uB0B4 \uAC00\uC871\uC744 \uC704\uD574... \uBAA8\uB4E0 \uAC83\uC744
        \uBC84\uB838\uB124."
      - "\uC790\uB124... \uC81C\uBC1C... \uB098\uCC98\uB7FC... \uB418\uC9C0 \uB9D0\uAC8C."
  - questState: 2
    questID: 2
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uC654\uB098? \uC7A5\uD130\uC5D0\uC11C \uC4F8 \uD1A0\uB07C \uAC00\uC8FD
        10\uAC1C\uAC00 \uD544\uC694\uD558\uB124."
      - "\uAC00\uC7A5 \uD754\uD558\uACE0 \uC57D\uD558\uB2C8, \uAE08\uBC29 \uD574\uC62C
        \uC218 \uC788\uACA0\uC9C0."
  - questState: 3
    questID: 2
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uADF8\uB7F4 \uC904 \uC54C\uC558\uB124."
      - "\uC26C\uC6B4 \uC77C\uB3C4 \uD3EC\uAE30\uD558\uB294\uAD70. \uAC00\uBCF4\uAC8C."
  - questState: 4
    questID: 2
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uAC00\uC838\uC654\uAD70. \uC4F8\uBAA8\uAC00 \uC788\uACA0\uC5B4. "
      - "\uD5C8\uD5C8... \uC790\uB124\uC758 \uB178\uACE0\uC5D0 \uB300\uD55C \uB300\uAC00\uC77C\uC138."
  - questState: 5
    questID: 2
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uAC00\uC8FD\uC740 \uC798 \uC4F0\uACE0 \uC788\uB124."
      - "\uACE0\uB9C8\uC6E0\uC5B4."
  - questState: 2
    questID: 3
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uB358\uC804\uC5D0 \uBE5B\uBC14\uB79C \uB3CC\uC774 \uB9CE\uB2E4\uACE0 \uD558\uB354\uAD70."
      - "\uC4F8\uBAA8\uB294 \uC5C6\uACA0\uC9C0\uB9CC... 10\uAC1C\uB9CC \uAC00\uC838\uB2E4\uC8FC\uAC8C."
      - "\uC774\uC0C1\uD558\uAC8C... \uB208\uC5D0 \uBC1F\uD600\uC11C."
  - questState: 4
    questID: 3
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uAC00\uC838\uC654\uAD70."
      - "\uBCC4 \uBCFC \uC77C \uC5C6\uB294 \uB3CC\uC774\uB124. \uC774\uAC70\uB098
        \uBC1B\uAC8C."
  - questState: 3
    questID: 3
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uC4F8\uBAA8\uC5C6\uB294 \uB3CC\uC774\uB2C8, \uCC3E\uC9C0 \uC54A\uC544\uB3C4
        \uC0C1\uAD00\uC5C6\uB124."
  - questState: 5
    questID: 3
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uB3CC\uC740 \uCC3D\uACE0\uC5D0 \uB123\uC5B4\uB480\uB124."
      - "\uC790\uAFB8 \uBCF4\uB2C8\uAE4C... \uAE30\uBD84\uC774 \uBB18\uD574\uC11C
        \uB9D0\uC774\uC57C."
  - questState: 2
    questID: 4
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uB358\uC804\uC5D0 \uC788\uB294 \uB098\uBB34\uC815\uB839\uC774 \uAC00\uC9C4
        \uD2BC\uD2BC\uD55C \uB098\uBB34 5\uAC1C\uAC00 \uD544\uC694\uD558\uB124."
      - "\uC790\uB124\uC758 \uAC15\uD55C \uD314\uB69D\uC73C\uB85C \uAD6C\uD574\uB2E4
        \uC8FC\uAC8C."
      - "\uC774 \uC7A5\uD130\uC758 \uBB3C\uAC74\uC744 \uB9CC\uB4DC\uB294 \uB370 \uC4F8\uBAA8\uAC00
        \uC788\uACA0\uC9C0."
  - questState: 4
    questID: 4
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uD6CC\uB96D\uD574. \uC774 \uC815\uB3C4\uBA74 \uC624\uB798 \uC4F8 \uC218
        \uC788\uACA0\uAD70."
      - "\uC790\uB124\uB294 \uAF64 \uBBFF\uC74C\uC9C1\uD558\uB124."
  - questState: 3
    questID: 4
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uB098\uBB34\uC815\uB839\uC774 \uB450\uB824\uC6B4\uAC00? "
      - "\uD558\uAE34... \uC232\uC758 \uAE30\uC6B4\uC740... \uD56D\uC0C1 \uC0AC\uB78C\uC744
        \uBD88\uD3B8\uD558\uAC8C \uB9CC\uB4E4\uC9C0."
  - questState: 5
    questID: 4
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uB098\uBB34 \uB355\uBD84\uC5D0 \uC7A5\uD130\uAC00 \uC880 \uD2BC\uD2BC\uD574\uC84C\uB124. "
      - "\uACE0\uB9C8\uC6E0\uC5B4."
  - questState: 2
    questID: 5
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uC790\uAFB8 \uB4E4\uC950 \uB5BC\uAC00 \uC0C1\uC810\uC744 \uAE30\uC6C3\uAC70\uB824."
      - "\uBB3C\uAC74\uC774 \uC0C1\uD558\uACA0\uC5B4."
      - "\uB4E4\uC950 5\uB9C8\uB9AC\uB97C \uCC98\uCE58\uD558\uACE0 \uC624\uAC8C."
      - "\uC4F8\uBAA8\uC5C6\uB294 \uB188\uB4E4\uC774\uC9C0."
  - questState: 4
    questID: 5
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uB4E4\uC950\uB4E4\uC774 \uC0AC\uB77C\uC84C\uAD70.\uACE0\uB9D9\uB124. "
      - "\uC0C1\uC778\uC5D0\uAC8C\uB294 \uBB3C\uAC74 \uBCF4\uD638\uAC00 \uCD5C\uC6B0\uC120\uC774\uB2C8."
  - questState: 3
    questID: 5
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uB4E4\uC950 \uD558\uB098 \uBABB \uC7A1\uACE0 \uBB58 \uD558\uACA0\uB098."
      - "\uAC00\uBCF4\uAC8C."
  - questState: 5
    questID: 5
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uB4E4\uC950\uB4E4\uC774 \uC870\uC6A9\uD574\uC9C0\uB2C8 \uC0B4 \uAC83 \uAC19\uB124.
        \uD558\uD558."
  - questState: 2
    questID: 6
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uB358\uC804\uC5D0 \uC0AC\uC2B4\uC774 \uC788\uB354\uAD70."
      - "\uADF8 \uC0AC\uC2B4\uC758 \uBFD4 3\uAC1C\uAC00 \uD544\uC694\uD558\uB124."
      - "\uB2E8\uB2E8\uD574\uC11C \uBB34\uC5B8\uAC00\uB97C \uB9CC\uB4E4 \uB54C \uC4F8\uBAA8\uAC00
        \uC788\uACA0\uC9C0"
      - "\uC0AC\uC2B4\uC744 \uC7A1\uC744 \uB550... \uB9DD\uC124\uC774\uC9C0 \uB9D0\uAC8C."
  - questState: 4
    questID: 6
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uBFD4\uC774 \uAF64 \uB2E8\uB2E8\uD558\uAD70. \uACE0\uB9D9\uB124."
      - "\uC790\uB124\uB294 \uAF64 \uC2E4\uB825\uC774 \uC788\uAD70."
  - questState: 3
    questID: 6
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uC0AC\uC2B4\uC774 \uC544\uB984\uB2E4\uC6E0\uB098? \uD558\uD558."
      - "\uD558\uC9C0\uB9CC \uC0C1\uC778\uC5D0\uAC8C \uC544\uB984\uB2E4\uC6C0\uC740
        \uB3C8\uC774 \uB418\uC9C0 \uC54A\uC544."
  - questState: 5
    questID: 6
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uBFD4 \uB355\uBD84\uC5D0 \uC88B\uC740 \uBB3C\uAC74\uC744 \uB9CC\uB4E4\uC5C8\uB124. "
      - "\uC790\uB124\uB3C4 \uD558\uB098 \uAC00\uC838\uAC00 \uBCF4\uAC8C."
  - questState: 2
    questID: 7
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uC232\uC758 \uC0B0\uC591\uC774 \uC0AC\uB098\uC6CC\uC84C\uB2E4\uACE0 \uD558\uB354\uAD70."
      - "\uB9C8\uC744 \uC0AC\uB78C\uB4E4\uC5D0\uAC8C \uD53C\uD574\uB97C \uC904\uAE4C
        \uBD10 \uAC71\uC815\uC774\uB124."
      - "\uC0B0\uC591 5\uB9C8\uB9AC\uB97C \uCC98\uCE58\uD558\uACE0 \uC640\uC8FC\uACA0\uB098"
  - questState: 4
    questID: 7
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uC0B0\uC591 \uB0C4\uC0C8\uAC00 \uC0AC\uB77C\uC84C\uAD70."
      - " \uACE0\uB9D9\uB124. \uC790\uB124 \uB355\uBD84\uC5D0 \uC7A5\uD130\uAC00
        \uC548\uC804\uD574\uC84C\uC5B4."
  - questState: 3
    questID: 7
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
      maxAffection: 100
      dialogueTexts:
      - "\uC0B0\uC591\uC740 \uAC15\uD558\uC9C0."
      - "\uB108\uBB34 \uBB34\uB9AC\uD558\uC9C0 \uB9D0\uAC8C."
      - "\uB0B4\uAC8C\uB294... \uC2E4\uD328\uC758 \uAE30\uC5B5\uC774 \uB9CE\uC73C\uB2C8."
  - questState: 5
    questID: 7
    interactionDialogue: []
    generalDialogues:
    - minAffection: -100
