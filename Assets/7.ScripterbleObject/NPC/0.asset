%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 670d9726321f0054c99e5763332ebb59, type: 3}
  m_Name: 0
  m_EditorClassIdentifier: 
  npcID: 0
  npcSprite: {fileID: 21300000, guid: e7bc8f6a1792bef45bf37cfe47112f3b, type: 3}
  npcName: "\uAC1C\uBC1C\uC790"
  npcPersonality: "\uAC1C\uBC1C\uC790"
  relationships: []
  playerAffection: -100
  dialogueGroups:
  - questState: 0
    questID: 0
    interactionDialogue:
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uC81C \uAC8C\uC784\uC744 \uD074\uB9AC\uC5B4\uD574\uC8FC\uC168\uAD70\uC694.\uC7AC\uBC0C\uAC8C
        \uC990\uAE30\uC168\uB098\uC694?"
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uC544\uC9C1 \uC644\uBCBD\uD558\uC9C0 \uC54A\uB2E4\uB294 \uAC70 \uC54C\uC544\uC694.\uC544\uB9C8
        \uC218\uB9CE\uC740 \uBC84\uADF8\uAC00 \uC788\uC5C8\uC744 \uAC78\uB85C \uC608\uC0C1\uB418\uB124\uC694..."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uC81C \uAC8C\uC784\uC758 \uC5B4\uB5A4 \uC810\uC774 \uC88B\uACE0 \uC5B4\uB5A4
        \uC810\uC774 \uC544\uC26C\uC6B0\uC168\uB098\uC694?"
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uAC00\uB2A5\uD558\uB2E4\uBA74 \uB2E4\uC74C\uC5D4 \uB354\uB354\uC6B1 \uD48D\uC131\uD55C
        \uAC8C\uC784\uC744 \uB9CC\uB4E4\uC5B4\uBCF4\uACE0 \uC2F6\uB124\uC694"
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC0AC\uC2E4 \uC774 \uAC8C\uC784\uC740 \uC804\uCCB4 \uACC4\uD68D\uC758 6\uBD84\uC758
        1 \uC218\uC900\uC774\uB78D\uB2C8\uB2E4."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uB098\uB984 \uC5F4\uC2EC\uD788 \uB9CC\uB4E4\uC5C8\uB294\uB370 \uC5B4\uB5BB\uAC8C
        \uB290\uB07C\uC168\uC744\uC9C0 \uBAA8\uB974\uACA0\uB124\uC694"
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uC800\uC5D0\uAC8C \uC774\uB807\uAC8C \uB9CE\uC740 \uB9D0\uC744 \uAC70\uC2DC\uB294
        \uC774\uC720\uAC00 \uC788\uB098\uC694?"
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uC81C\uAC00 \uB4DC\uB9B4 \uC218 \uC788\uB294 \uAC74 \uB530\uB85C \uC5C6\uC2B5\uB2C8\uB2E4\uB9CC
        \uC5EC\uAE30\uAE4C\uC9C0 \uC990\uACA8\uC8FC\uC2DC\uB2E4\uB2C8 \uAC10\uB3D9
        \uADF8 \uC790\uCCB4\uC5D0\uC694!"
    generalDialogues:
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uD574\uB2F9 \uAC8C\uC784\uC740 \uC57D \uB450\uB2EC \uB3D9\uC548 \uB9CC\uB4E0
        \uAC8C\uC784\uC774\uC5D0\uC694."
      - "\uC2A4\uD300\uCD9C\uC2DC\uB97C \uBAA9\uD45C\uB85C \uB9CC\uB4E4\uC5C8\uC73C\uB098
        \uBCF4\uC2DC\uB2E4\uC2DC\uD53C \uC644\uC131\uB3C4\uAC00 \uB192\uC9C0 \uC54A\uC544
        \uCD9C\uC2DC\uB294 \uC5B4\uB835\uAC8C \uB418\uC5C8\uC9C0\uC694..."
      - "\uD074\uB9AC\uC5B4 \uC774\uD6C4 \uC2DD\uB2F9\uC774 \uC624\uD508 \uB418\uC5C8\uC744\uD14C\uB2C8
        \uD55C\uBC88 \uC2DD\uB2F9\uC870\uAC01\uC744 \uBC30\uCE58\uD574\uC11C \uC694\uB9AC\uB3C4
        \uD574\uBCF4\uC2DC\uBA74 \uC88B\uC744 \uAC83 \uAC19\uC544\uC694!"
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uB098\uB984 \uC5EC\uB7EC\uAC00\uC9C0 \uCF58\uD150\uCE20\uB97C \uCD94\uAC00\uD558\uACE0
        \uB2E4\uC591\uD55C \uC990\uAC70\uC6C0\uC744 \uC120\uC0AC\uD558\uB824\uACE0
        \uB178\uB825\uD588\uC5B4\uC694."
      - "\uB2E4\uB9CC \uC774\uC81C\uBCF4\uB2C8 \uC5B4\uB290\uD558\uB098 \uC644\uC131\uB3C4\uAC00
        \uB192\uC9C0 \uC54A\uACE0 \uB09C\uD574\uD55C \uAC8C\uC784\uC774 \uB41C \uAC83
        \uAC19\uC544 \uC544\uC26C\uC6B8 \uB530\uB984\uC774\uC5D0\uC694."
      - "\uAC00\uB2A5\uD558\uB2E4\uBA74 \uC5C5\uB370\uC774\uD2B8\uB97C \uC9C0\uC18D\uC801\uC73C\uB85C
        \uD574\uC11C \uC644\uC131\uB3C4\uB3C4 \uB192\uC774\uACE0 \uC2A4\uD300 \uCD9C\uC2DC\uB3C4
        \uB3C4\uC804\uD574\uBCF4\uACE0 \uC2F6\uB124\uC694."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uB9CC\uC57D \uC5C5\uB370\uC774\uD2B8\uB97C \uD558\uAC8C \uB41C\uB2E4\uBA74
        \uCD94\uAC00\uD558\uACE0 \uC2F6\uC740 \uCF58\uD150\uCE20\uAC00 \uC815\uB9D0
        \uB9CE\uC544\uC694."
      - "\uC6B0\uC120 \uC9C0\uAE08\uC740 \uB358\uC804 \uC885\uB958\uAC00 \uC232 \uD558\uB098
        \uBFD0\uC774\uC9C0\uB9CC \uACC4\uACE1,\uC0AC\uB9C9,\uC6A9\uC554,\uBE59\uD558,\uC2EC\uC5F0\uC744
        \uCD94\uAC00\uD558\uACE0 \uC2F6\uB124\uC694!"
      - "\uB358\uC804\uC744 \uD074\uB9AC\uC5B4\uD560\uB54C\uB9C8\uB2E4 \uC0C8\uB85C\uC6B4
        \uAE30\uB2A5\uC744 \uAC00\uC9C4 \uB9C8\uC744\uB3C4 \uCD94\uAC00\uD558\uACE0
        \uC2F6\uC5B4\uC694!"
      - "\uC9C0\uAE08\uC740 \uC7A1\uD654\uC810\uACFC \uC2DD\uB2F9 \uBFD0\uC774\uC9C0\uB9CC,\uB300\uC7A5\uAC04,\uB18D\uC0AC,\uB09A\uC2DC,\uB3C4\uC11C\uAD00,\uC5EC\uAD00
        \uB4F1\uC744 \uCD94\uAC00\uD558\uACE0 \uC2F6\uC5B4\uC694!"
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uBD80\uB514 \uC774 \uAC8C\uC784\uC774 \uC544\uB2C8\uB354\uB77C\uB3C4 \uC5B8\uC820\uAC04
        \uC81C\uAC00 \uC6D0\uD558\uB294 \uAC8C\uC784\uC744 \uB9CE\uC740 \uC774\uB4E4\uC774
        \uC990\uACA8\uC92C\uC73C\uBA74 \uC88B\uACA0\uC5B4\uC694."
      - "\uADF8\uB584\uAC00 \uB41C\uB2E4\uBA74 \uC9C0\uAE08\uC740 \uC0C1\uC0C1\uC73C\uB85C\uB9CC
        \uAC00\uC9C0\uACE0 \uC788\uB294 \uAC8C\uC784\uC744 \uC81C\uAC00 \uC9C1\uC811
        \uAD6C\uD604\uD574\uB0C8\uB2E4\uB294 \uAC70\uACA0\uC8E0."
      - "\uB354\uC774\uC0C1 \uB2F9\uC2E0\uC5D0\uAC8C \uB4DC\uB9B4 \uB9D0\uC500\uC740
        \uC5C6\uC5B4\uC694."
      - "\uD558\uC2DC\uB294 \uC77C \uBAA8\uB450 \uC798\uB418\uC2DC\uACE0 \uAC00\uC2DC\uB294
        \uAE38\uC5D0 \uD589\uBCF5\uB9CC \uAC00\uB4DD\uD558\uAE30\uB97C \uBC14\uB784\uAC8C\uC694!"
