  relationships: []
  playerAffection: -100
  dialogueGroups:
  - questState: 0
    questID: 0
    interactionDialogue:
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uC81C \uAC8C\uC784\uC744 \uD074\uB9AC\uC5B4\uD574\uC8FC\uC168\uAD70\uC694.\uC7AC\uBC0C\uAC8C
        \uC990\uAE30\uC168\uB098\uC694?"
    - minAffection: -100
      maxAffection: -50
      dialogueTexts:
      - "\uC544\uC9C1 \uC644\uBCBD\uD558\uC9C0 \uC54A\uB2E4\uB294 \uAC70 \uC54C\uC544\uC694.\uC544\uB9C8
        \uC218\uB9CE\uC740 \uBC84\uADF8\uAC00 \uC788\uC5C8\uC744 \uAC78\uB85C \uC608\uC0C1\uB418\uB124\uC694..."
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uD074\uB9AC\uC5B4 \uD6C4\uC5D4 \uB530\uB85C \uCD94\uAC00\uD55C \uCF58\uD150\uCE20\uAC00
        \uC5C6\uB294\uB370 \uBB34\uC5C7\uC744 \uC990\uAE30\uACE0 \uACC4\uC2E0\uAC00\uC694?"
    - minAffection: -50
      maxAffection: 0
      dialogueTexts:
      - "\uAC00\uB2A5\uD558\uB2E4\uBA74 \uB2E4\uC74C\uC5D4 \uB354\uB354\uC6B1 \uD48D\uC131\uD55C
        \uAC8C\uC784\uC744 \uB9CC\uB4E4\uC5B4\uBCF4\uACE0 \uC2F6\uB124\uC694"
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC0AC\uC2E4 \uC774 \uAC8C\uC784\uC740 \uC804\uCCB4 \uACC4\uD68D\uC758 6\uBD84\uC758
        1 \uC218\uC900\uC774\uB78D\uB2C8\uB2E4."
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uB098\uB984 \uC5F4\uC2EC\uD788 \uB9CC\uB4E4\uC5C8\uB294\uB370 \uC5B4\uB5BB\uAC8C
        \uB290\uB07C\uC168\uC744\uC9C0 \uBAA8\uB974\uACA0\uB124\uC694"
    - minAffection: 50
      maxAffection: 100
      dialogueTexts:
      - "\uC800\uC5D0\uAC8C \uC774\uB807\uAC8C \uB9CE\uC740 \uB9D0\uC744 \uAC70\uC2DC\uB294
        \uC774\uC720\uAC00 \uC788\uB098\uC694?"
    - minAffection: 0
      maxAffection: 50
      dialogueTexts:
      - "\uC81C\uAC00 \uB4DC\uB9B4 \uC218 \uC788\uB294 \uAC74 \uB530\uB85C \uC5C6\uC2B5\uB2C8\uB2E4\uB9CC
        \uC5EC\uAE30\uAE4C\uC9C0 \uC990\uACA8\uC8FC\uC2DC\uB2E4\uB2C8 \uAC10\uB3D9
        \uADF8 \uC790\uCCB4\uC5D0\uC694!"
    generalDialogues: []
